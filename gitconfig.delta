[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    line-numbers = true
    hyperlinks = true
    # Side by side view. Disable by using `DELTA_FEATURES=+` before use of delta
    side-by-side = true

[merge]
    conflictStyle = zdiff3

